{
  "id": "internet-archive",
  "nombre": "Internet Archive (películas)",
  "tipo": "pelicula",
  "baseUrl": "https://archive.org",
  "buscar": {
    "ruta": "/advancedsearch.php",
    "params": {
      "q": "title:({$q}) AND mediatype:movies",
      "rows": "20",
      "page": "{$page}",
      "output": "json"
    },
    "lista": "response.docs",
    "campos": {
      "id": "{identifier}",
      "titulo": "{title}",
      "portada": "https://archive.org/services/img/{identifier}"
    }
  },
  "capitulos": {
    "ruta": "/metadata/{$id}",
    "lista": "files",
    "filtro": "name~.*\\.mp4",
    "campos": {
      "id": "{$id}|{name}",
      "nombre": "{name}"
    }
  },
  "contenido": {
    "campos": {
      "url": "https://archive.org/download/{$id0}/{$id1}"
    }
  },
  "populares": {
    "ruta": "/advancedsearch.php",
    "params": {
      "q": "mediatype:movies",
      "sort[]": "downloads desc",
      "rows": "20",
      "page": "{$page}",
      "output": "json"
    },
    "lista": "response.docs",
    "campos": {
      "id": "{identifier}",
      "titulo": "{title}",
      "portada": "https://archive.org/services/img/{identifier}"
    }
  }
}