{
  "id": "mangadex",
  "nombre": "MangaDex",
  "tipo": "manga",
  "baseUrl": "https://api.mangadex.org",
  "headers": {
    "User-Agent": "Nexo/0.1"
  },
  "buscar": {
    "ruta": "/manga",
    "params": {
      "title": "{$q}",
      "limit": "20",
      "offset": "{$offset}",
      "includes[]": "cover_art"
    },
    "lista": "data",
    "campos": {
      "id": "{id}",
      "titulo": "{attributes.title.en|attributes.title.es|attributes.title.ja-ro|attributes.title.ja}",
      "portada": "https://uploads.mangadex.org/covers/{id}/{relationships[type=cover_art].attributes.fileName}.512.jpg"
    }
  },
  "capitulos": {
    "ruta": "/manga/{$id}/feed",
    "params": {
      "translatedLanguage[]": "en",
      "limit": "100",
      "order[chapter]": "asc"
    },
    "lista": "data",
    "campos": {
      "id": "{id}",
      "nombre": "Cap. {attributes.chapter} {attributes.title}"
    }
  },
  "contenido": {
    "ruta": "/at-home/server/{$id}",
    "lista": "chapter.data",
    "campos": {
      "url": "{$root.baseUrl}/data/{$root.chapter.hash}/{$item}"
    }
  },
  "populares": {
    "ruta": "/manga",
    "params": {
      "limit": "20",
      "offset": "{$offset}",
      "includes[]": "cover_art",
      "order[followedCount]": "desc"
    },
    "lista": "data",
    "campos": {
      "id": "{id}",
      "titulo": "{attributes.title.en|attributes.title.es|attributes.title.ja-ro|attributes.title.ja}",
      "portada": "https://uploads.mangadex.org/covers/{id}/{relationships[type=cover_art].attributes.fileName}.512.jpg"
    }
  }
}